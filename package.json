{
  "name": "ieom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,app -c cyan,yellow \"pnpm --filter @ieom/server dev\" \"pnpm --filter @ieom/admin dev\"",
    "build": "pnpm --filter @ieom/admin build",
    "start": "pnpm build && pnpm --filter @ieom/server start",
    "server": "pnpm --filter @ieom/server dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "better-sqlite3"]
  }
}
