{
  "name": "@ieom/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && tsc -p tsconfig.preload.json",
    "prebuild:dev": "pnpm --filter @ieom/server build && pnpm --filter @ieom/overlay build && pnpm --filter @ieom/admin build",
    "build:dev": "tsc && electron .",
    "package": "electron-builder --config electron-builder.yml",
    "package:win": "electron-builder --config electron-builder.yml --win",
    "package:mac": "electron-builder --config electron-builder.yml --mac",
    "package:linux": "electron-builder --config electron-builder.yml --linux",
    "package:all": "electron-builder --config electron-builder.yml -mwl",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ieom/server": "workspace:*",
    "@ieom/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/sql.js": "^1.4.11",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "fast-check": "^3.22.0",
    "typescript": "^5.5.2",
    "vitest": "^2.1.8"
  }
}
