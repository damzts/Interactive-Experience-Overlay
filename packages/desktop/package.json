{
  "name": "@ieom/desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "predev": "node scripts/rebuild-sqlite.mjs",
    "dev": "electron .",
    "build": "tsc && tsc -p tsconfig.preload.json",
    "bundle-server": "node scripts/bundle-server.mjs",
    "prebuild:dev": "pnpm --filter @ieom/server build && pnpm --filter @ieom/overlay build && pnpm --filter @ieom/admin build",
    "build:dev": "tsc && electron .",
    "package": "pnpm bundle-server && electron-builder --config electron-builder.yml",
    "package:win": "pnpm bundle-server && electron-builder --config electron-builder.yml --win",
    "package:mac": "pnpm bundle-server && electron-builder --config electron-builder.yml --mac",
    "package:linux": "pnpm bundle-server && electron-builder --config electron-builder.yml --linux",
    "package:all": "pnpm bundle-server && electron-builder --config electron-builder.yml -mwl",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ieom/server": "workspace:*",
    "@ieomlabs/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.3.9",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "esbuild": "0.28.1",
    "fast-check": "^3.22.0",
    "node-abi": "^4.31.0",
    "typescript": "^5.5.2",
    "vitest": "^4.0.0"
  }
}
