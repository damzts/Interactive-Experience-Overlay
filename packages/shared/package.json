{
  "name": "@ieomlabs/shared",
  "version": "1.0.0",
  "description": "Shared types and contracts for IEOM (backend, frontend, overlay)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud/index.d.ts",
      "import": "./dist/cloud/index.js",
      "default": "./dist/cloud/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "ieom",
    "shared",
    "types",
    "contracts"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ieomlabs/Interactive-Experience-Overlay.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/damzts/Interactive-Experience-Overlay/issues"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "vitest": "^2.1.9"
  }
}
